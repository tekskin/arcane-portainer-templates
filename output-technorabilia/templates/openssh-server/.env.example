# Generated from the Portainer template registry.
# Review values before deployment.

# Root replacing the old Portainer /portainer path.
PORTAINER_ROOT=/mnt/portainer
# PUID: Run 'id [USER]' for the owner of the host volume directories to get the UID to use here.
PUID=1000
# PGID: Run 'id [USER]' for the owner of the host volume directories to get the GID to use here.
PGID=1000
# TZ: specify a timezone to use, see this [list](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List).
TZ=Etc/UTC
# PUBLIC_KEY: Optional ssh public key, which will automatically be added to authorized_keys. [OPTIONAL]
PUBLIC_KEY=yourpublickey
# PUBLIC_KEY_FILE: Optionally specify a file containing the public key (works with docker secrets). [OPTIONAL]
PUBLIC_KEY_FILE=/path/to/file
# PUBLIC_KEY_DIR: Optionally specify a directory containing the public keys (works with docker secrets). [OPTIONAL]
PUBLIC_KEY_DIR=/path/to/directory/containing/_only_/pubkeys
# PUBLIC_KEY_URL: Optionally specify a URL containing the public key. [OPTIONAL]
PUBLIC_KEY_URL=https://github.com/username.keys
# SUDO_ACCESS: Set to `true` to allow `linuxserver.io`, the ssh user, sudo access. Without `USER_PASSWORD` set, this will allow passwordless sudo access. [OPTIONAL]
SUDO_ACCESS=false
# PASSWORD_ACCESS: Set to `true` to allow user/password ssh access. You will want to set `USER_PASSWORD` or `USER_PASSWORD_FILE` as well. [OPTIONAL]
PASSWORD_ACCESS=false
# USER_PASSWORD: Optionally set a sudo password for `linuxserver.io`, the ssh user. If this or `USER_PASSWORD_FILE` are not set but `SUDO_ACCESS` is set to true, the user will have passwordless sudo access. [OPTIONAL]
USER_PASSWORD=password
# USER_PASSWORD_FILE: Optionally specify a file that contains the password. This setting supersedes the `USER_PASSWORD` option (works with docker secrets). [OPTIONAL]
USER_PASSWORD_FILE=/path/to/file
# USER_NAME: Optionally specify a user name (Default:`linuxserver.io`) [OPTIONAL]
USER_NAME=linuxserver.io
# LOG_STDOUT: Set to `true` to log to stdout instead of file. [OPTIONAL]
LOG_STDOUT=
