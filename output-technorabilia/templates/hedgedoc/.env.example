# Generated from the Portainer template registry.
# Review values before deployment.

# Root replacing the old Portainer /portainer path.
PORTAINER_ROOT=/mnt/portainer
# PUID: Run 'id [USER]' for the owner of the host volume directories to get the UID to use here.
PUID=1000
# PGID: Run 'id [USER]' for the owner of the host volume directories to get the GID to use here.
PGID=1000
# TZ: specify a timezone to use, see this [list](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List).
TZ=Etc/UTC
# DB_HOST: Host address of mariadb database
DB_HOST=<hostname or ip>
# DB_PORT: Port to access mariadb database default is 3306
DB_PORT=3306
# DB_USER: Database user
DB_USER=hedgedoc
# DB_PASS: Database password
DB_PASS=<secret password>
# DB_NAME: Database name
DB_NAME=hedgedoc
# CMD_DOMAIN: The address the gui will be accessed at (ie. `192.168.1.1` or `hedgedoc.domain.com`).
CMD_DOMAIN=localhost
# CMD_URL_ADDPORT: Set to `true` if using a port other than `80` or `443`. [OPTIONAL]
CMD_URL_ADDPORT=false
# CMD_PROTOCOL_USESSL: Set to `true` if accessing over https via reverse proxy. [OPTIONAL]
CMD_PROTOCOL_USESSL=false
# CMD_PORT: If you wish to access hedgedoc at a port different than 80, 443 or 3000, you need to set this to that port (ie. `CMD_PORT=5000`) and change the port mapping accordingly (5000:5000). [OPTIONAL]
CMD_PORT=3000
# CMD_ALLOW_ORIGIN: Comma-separated list of allowed hostnames [OPTIONAL]
CMD_ALLOW_ORIGIN=['localhost']
# CMD_DB_DIALECT: This variable allows selecting a database engine (if DB_HOST not set up). Available options are: `mariadb`, `mysql`, `postgres`, `sqlite`. [OPTIONAL]
CMD_DB_DIALECT=
