# Generated from the Portainer template registry.
# Review values before deployment.

# Root replacing the old Portainer /portainer path.
PORTAINER_ROOT=/mnt/portainer
# PUID: Run 'id [USER]' for the owner of the host volume directories to get the UID to use here.
PUID=1000
# PGID: Run 'id [USER]' for the owner of the host volume directories to get the GID to use here.
PGID=1000
# TZ: specify a timezone to use, see this [list](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List).
TZ=Etc/UTC
# SUPERUSER_EMAIL: Email address for `admin` account
SUPERUSER_EMAIL=
# SUPERUSER_PASSWORD: Password for `admin` account
SUPERUSER_PASSWORD=
# ALLOWED_HOST: The hostname you will use to access the app (e.g., netbox.example.com)
ALLOWED_HOST=
# DB_NAME: Database name (default: netbox)
DB_NAME=
# DB_USER: Database user
DB_USER=
# DB_PASSWORD: Database password
DB_PASSWORD=
# DB_HOST: Database host (default: postgres)
DB_HOST=
# DB_PORT: Database port (default: 5432)
DB_PORT=
# REDIS_HOST: Redis host (default: redis)
REDIS_HOST=
# REDIS_PORT: Redis port number (default: 6379)
REDIS_PORT=
# REDIS_USERNAME: Redis username (default: none)
REDIS_USERNAME=
# REDIS_PASSWORD: Redis password (default: none)
REDIS_PASSWORD=
# REDIS_DB_TASK: Redis database ID for tasks (default: 0)
REDIS_DB_TASK=
# REDIS_DB_CACHE: Redis database ID for caching (default: 1)
REDIS_DB_CACHE=
# BASE_PATH: The path you will use to access the app (i.e., /netbox, default: none) [OPTIONAL]
BASE_PATH=
# CSRF_TRUSTED_ORIGINS: List of comma-separated, single quoted, trusted origins. Must include protocol, and port if applicable (default: []) [OPTIONAL]
CSRF_TRUSTED_ORIGINS=
# REMOTE_AUTH_ENABLED: Enable remote authentication (default: False) [OPTIONAL]
REMOTE_AUTH_ENABLED=
# REMOTE_AUTH_BACKEND: Python path to the custom Django authentication backend to use for external user authentication (default: netbox.authentication.RemoteUserBackend) [OPTIONAL]
REMOTE_AUTH_BACKEND=
# REMOTE_AUTH_HEADER: Name of the HTTP header which informs NetBox of the currently authenticated user. (default: HTTP_REMOTE_USER) [OPTIONAL]
REMOTE_AUTH_HEADER=
# REMOTE_AUTH_AUTO_CREATE_USER: If true, NetBox will automatically create local accounts for users authenticated via a remote service (default: False) [OPTIONAL]
REMOTE_AUTH_AUTO_CREATE_USER=
# REMOTE_AUTH_DEFAULT_GROUPS: The list of groups to assign a new user account when created using remote authentication (default: []) [OPTIONAL]
REMOTE_AUTH_DEFAULT_GROUPS=
# REMOTE_AUTH_DEFAULT_PERMISSIONS: A mapping of permissions to assign a new user account when created using remote authentication (default: {}) [OPTIONAL]
REMOTE_AUTH_DEFAULT_PERMISSIONS=
