# Generated from the Portainer template registry.
# Review values before deployment.

# Root replacing the old Portainer /portainer path.
PORTAINER_ROOT=/mnt/portainer
# PUID: Run 'id [USER]' for the owner of the host volume directories to get the UID to use here.
PUID=1000
# PGID: Run 'id [USER]' for the owner of the host volume directories to get the GID to use here.
PGID=1000
# TZ: specify a timezone to use, see this [list](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List).
TZ=Etc/UTC
# TRANSMISSION_WEB_HOME: Specify the path to an alternative UI folder. [OPTIONAL]
TRANSMISSION_WEB_HOME=
# USER: Specify an optional username for the interface [OPTIONAL]
USER=
# PASS: Specify an optional password for the interface [OPTIONAL]
PASS=
# WHITELIST: Specify an optional list of comma separated ip whitelist. Fills rpc-whitelist setting. [OPTIONAL]
WHITELIST=
# PEERPORT: Specify an optional port for torrent TCP/UDP connections. Fills peer-port setting. [OPTIONAL]
PEERPORT=
# HOST_WHITELIST: Specify an optional list of comma separated dns name whitelist. Fills rpc-host-whitelist setting. [OPTIONAL]
HOST_WHITELIST=
