# Generated from the Portainer template registry.
# Review values before deployment.

# Root replacing the old Portainer /portainer path.
PORTAINER_ROOT=/mnt/portainer
# PUID: Run 'id [USER]' for the owner of the host volume directories to get the UID to use here.
PUID=1000
# PGID: Run 'id [USER]' for the owner of the host volume directories to get the GID to use here.
PGID=1000
# TZ: specify a timezone to use, see this [list](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List).
TZ=Etc/UTC
# DB_CONNECTION: DB type, from `sqlite`, `mysql`, `pqsql`.
DB_CONNECTION=
# DB_HOST: DB server hostname. For `mysql` and `pgsql` only.
DB_HOST=
# DB_PORT: DB server port. For `mysql` and `pgsql` only.
DB_PORT=
# DB_USERNAME: DB user. For `mysql` and `pgsql` only.
DB_USERNAME=
# DB_PASSWORD: DB password. For `mysql` and `pgsql` only.
DB_PASSWORD=
# DB_DATABASE: Path to DB file for `sqlite`. DB name for `mysql` and `pgsql`.
DB_DATABASE=
# APP_NAME: The gallery name. [OPTIONAL]
APP_NAME=Lychee
# APP_URL: The URL you will use to access Lychee including protocol, and port where appropriate. [OPTIONAL]
APP_URL=
# TRUSTED_PROXIES: Set to the IP or netmask covering your reverse proxy, if running behind one. Set to `*` to trust all IPs (**do not** use `*` if exposed to the internet`). [OPTIONAL]
TRUSTED_PROXIES=
