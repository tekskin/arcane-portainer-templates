# Generated from the Portainer template registry.
# Review values before deployment.

# Root replacing the old Portainer /portainer path.
PORTAINER_ROOT=/mnt/portainer
# PUID: Run 'id [USER]' for the owner of the host volume directories to get the UID to use here.
PUID=1000
# PGID: Run 'id [USER]' for the owner of the host volume directories to get the GID to use here.
PGID=1000
# TZ: specify a timezone to use, see this [list](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List).
TZ=Etc/UTC
# MYSQL_ROOT_PASSWORD: Set this to root password for installation (minimum 4 characters & non-alphanumeric passwords must be properly escaped). (valid only for first run)
MYSQL_ROOT_PASSWORD=ROOT_ACCESS_PASSWORD
# MYSQL_DATABASE: Specify the name of a database to be created. (valid only for first run) [OPTIONAL]
MYSQL_DATABASE=USER_DB_NAME
# MYSQL_USER: This user will have superuser access to the database specified by MYSQL_DATABASE (do not use root here). (valid only for first run) [OPTIONAL]
MYSQL_USER=MYSQL_USER
# MYSQL_PASSWORD: Set this to the password you want to use for you MYSQL_USER (minimum 4 characters & non-alphanumeric passwords must be properly escaped). (valid only for first run) [OPTIONAL]
MYSQL_PASSWORD=DATABASE_PASSWORD
# REMOTE_SQL: Set this to ingest sql files from an http/https endpoint (comma seperated array). [OPTIONAL]
REMOTE_SQL=http://URL1/your.sql,https://URL2/your.sql
# CLI_OPTS: Pass CLI options to mariadbd via mariadbd-safe. Use with caution as mariadbd option precedence is complex. [OPTIONAL]
CLI_OPTS=
