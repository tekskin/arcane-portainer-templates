# Generated from the Portainer template registry.
# Review values before deployment.

# Root replacing the old Portainer /portainer path.
PORTAINER_ROOT=/mnt/portainer
# PUID: Run 'id [USER]' for the owner of the host volume directories to get the UID to use here.
PUID=1000
# PGID: Run 'id [USER]' for the owner of the host volume directories to get the GID to use here.
PGID=1000
# TZ: specify a timezone to use, see this [list](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List).
TZ=Etc/UTC
# PASSWORD: Set the password for the results database.
PASSWORD=PASSWORD
# CUSTOM_RESULTS: (optional) set to `true` to enable custom results page in `/config/www/results/index.php`. [OPTIONAL]
CUSTOM_RESULTS=false
# DB_TYPE: Defaults to `sqlite`, can also be set to `mysql` or `postgresql`. [OPTIONAL]
DB_TYPE=sqlite
# DB_NAME: Database name. Required for mysql and pgsql. [OPTIONAL]
DB_NAME=DB_NAME
# DB_HOSTNAME: Database address. Required for mysql and pgsql. [OPTIONAL]
DB_HOSTNAME=DB_HOSTNAME
# DB_USERNAME: Database username. Required for mysql and pgsql. [OPTIONAL]
DB_USERNAME=DB_USERNAME
# DB_PASSWORD: Database password. Required for mysql and pgsql. [OPTIONAL]
DB_PASSWORD=DB_PASSWORD
# DB_PORT: Database port. Required for mysql. [OPTIONAL]
DB_PORT=DB_PORT
# IPINFO_APIKEY: Access token from ipinfo.io. Required for detailed IP information. [OPTIONAL]
IPINFO_APIKEY=ACCESS_TOKEN
