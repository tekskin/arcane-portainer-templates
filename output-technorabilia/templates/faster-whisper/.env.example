# Generated from the Portainer template registry.
# Review values before deployment.

# Root replacing the old Portainer /portainer path.
PORTAINER_ROOT=/mnt/portainer
# PUID: Run 'id [USER]' for the owner of the host volume directories to get the UID to use here.
PUID=1000
# PGID: Run 'id [USER]' for the owner of the host volume directories to get the GID to use here.
PGID=1000
# TZ: specify a timezone to use, see this [list](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List).
TZ=Etc/UTC
# DEBUG: If set to `true`, or any other value, the container will output debug logs. [OPTIONAL]
DEBUG=
# LOCAL_ONLY: If set to `true`, or any other value, the container will not attempt to download models from HuggingFace and will only use locally-provided models. [OPTIONAL]
LOCAL_ONLY=
# WHISPER_BEAM: Number of candidates to consider simultaneously during transcription. [OPTIONAL]
WHISPER_BEAM=1
# WHISPER_LANG: Two character code for the language that you will speak to the add-on. [OPTIONAL]
WHISPER_LANG=auto
# WHISPER_MODEL: Whisper model that will be used for transcription. From [here](https://github.com/SYSTRAN/faster-whisper/blob/master/faster_whisper/utils.py#L11-L31). [OPTIONAL]
WHISPER_MODEL=auto
