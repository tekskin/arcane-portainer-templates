# Generated from the Portainer template registry.
# Review values before deployment.

# Root replacing the old Portainer /portainer path.
PORTAINER_ROOT=/mnt/portainer
# PUID: Run 'id [USER]' for the owner of the host volume directories to get the UID to use here.
PUID=1000
# PGID: Run 'id [USER]' for the owner of the host volume directories to get the GID to use here.
PGID=1000
# TZ: specify a timezone to use, see this [list](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List).
TZ=Etc/UTC
# PASSWORD: Optional web gui password, if `PASSWORD` or `HASHED_PASSWORD` is not provided, there will be no auth. [OPTIONAL]
PASSWORD=password
# HASHED_PASSWORD: Optional web gui password, overrides `PASSWORD`, instructions on how to create it is below. [OPTIONAL]
HASHED_PASSWORD=
# SUDO_PASSWORD: If this optional variable is set, user will have sudo access in the code-server terminal with the specified password. [OPTIONAL]
SUDO_PASSWORD=password
# SUDO_PASSWORD_HASH: Optionally set sudo password via hash (takes priority over `SUDO_PASSWORD` var). Format is `$type$salt$hashed`. [OPTIONAL]
SUDO_PASSWORD_HASH=
# PROXY_DOMAIN: If this optional variable is set, this domain will be proxied for subdomain proxying. See [Documentation](https://github.com/coder/code-server/blob/main/docs/guide.md#using-a-subdomain) [OPTIONAL]
PROXY_DOMAIN=code-server.my.domain
# DEFAULT_WORKSPACE: If this optional variable is set, code-server will open this directory by default [OPTIONAL]
DEFAULT_WORKSPACE=/config/workspace
# PWA_APPNAME: If this optional variable is set, the PWA app will the specified name. [OPTIONAL]
PWA_APPNAME=code-server
