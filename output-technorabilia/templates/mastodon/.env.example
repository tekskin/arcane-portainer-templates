# Generated from the Portainer template registry.
# Review values before deployment.

# Root replacing the old Portainer /portainer path.
PORTAINER_ROOT=/mnt/portainer
# PUID: Run 'id [USER]' for the owner of the host volume directories to get the UID to use here.
PUID=1000
# PGID: Run 'id [USER]' for the owner of the host volume directories to get the GID to use here.
PGID=1000
# TZ: specify a timezone to use, see this [list](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List).
TZ=Etc/UTC
# LOCAL_DOMAIN: This is the unique identifier of your server in the network. It cannot be safely changed later.
LOCAL_DOMAIN=example.com
# REDIS_HOST: Redis server hostname
REDIS_HOST=redis
# REDIS_PORT: Redis port
REDIS_PORT=6379
# DB_HOST: Postgres database hostname
DB_HOST=db
# DB_USER: Postgres username
DB_USER=mastodon
# DB_NAME: Postgres db name
DB_NAME=mastodon
# DB_PASS: Postgres password
DB_PASS=mastodon
# DB_PORT: Postgres port
DB_PORT=5432
# ES_ENABLED: Enable or disable Elasticsearch (requires a separate ES instance)
ES_ENABLED=false
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY: Primary key for [Active Record Encryption](https://github.com/mastodon/mastodon/pull/29831/files).
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY: Deterministic key for [Active Record Encryption](https://github.com/mastodon/mastodon/pull/29831/files).
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT: Derivation salt for [Active Record Encryption](https://github.com/mastodon/mastodon/pull/29831/files).
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# SECRET_KEY_BASE: Browser session secret. Changing it will break all active browser sessions.
SECRET_KEY_BASE=
# OTP_SECRET: MFA secret. Changing it after initial setup will break two-factor authentication.
OTP_SECRET=
# VAPID_PRIVATE_KEY: Push notification private key. Changing it after initial setup will break push notifications.
VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY: Push notification public key. Changing it after initial setup will break push notifications.
VAPID_PUBLIC_KEY=
# SMTP_SERVER: SMTP server for email notifications
SMTP_SERVER=mail.example.com
# SMTP_PORT: SMTP server port
SMTP_PORT=25
# SMTP_LOGIN: SMTP username
SMTP_LOGIN=
# SMTP_PASSWORD: SMTP password
SMTP_PASSWORD=
# SMTP_FROM_ADDRESS: From address for emails send from Mastodon
SMTP_FROM_ADDRESS=notifications@example.com
# S3_ENABLED: Enable or disable S3 storage of uploaded files
S3_ENABLED=false
# WEB_DOMAIN: This can be set if you want your server identifier to be different to the subdomain hosting Mastodon. See [https://docs.joinmastodon.org/admin/config/#basic](https://docs.joinmastodon.org/admin/config/#basic) [OPTIONAL]
WEB_DOMAIN=mastodon.example.com
# ES_HOST: Elasticsearch server hostname [OPTIONAL]
ES_HOST=es
# ES_PORT: Elasticsearch port [OPTIONAL]
ES_PORT=9200
# ES_USER: Elasticsearch username [OPTIONAL]
ES_USER=elastic
# ES_PASS: Elasticsearch password [OPTIONAL]
ES_PASS=elastic
# S3_BUCKET: S3 bucket hostname [OPTIONAL]
S3_BUCKET=
# AWS_ACCESS_KEY_ID: S3 bucket access key ID [OPTIONAL]
AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY: S3 bucket secret access key [OPTIONAL]
AWS_SECRET_ACCESS_KEY=
# S3_ALIAS_HOST: Alternate hostname for object fetching if you are front the S3 connections. [OPTIONAL]
S3_ALIAS_HOST=
# SIDEKIQ_ONLY: Only run the sidekiq service in this container instance. For large scale instances that need better queue handling. [OPTIONAL]
SIDEKIQ_ONLY=false
# SIDEKIQ_QUEUE: The name of the sidekiq queue to run in this container. See [notes](https://docs.joinmastodon.org/admin/scaling/#sidekiq-queues). [OPTIONAL]
SIDEKIQ_QUEUE=
# SIDEKIQ_DEFAULT: Set to `true` on the main container if you're running additional sidekiq instances. It will run the `default` queue. [OPTIONAL]
SIDEKIQ_DEFAULT=false
# SIDEKIQ_THREADS: The number of threads for sidekiq to use. See [notes](https://docs.joinmastodon.org/admin/scaling/#sidekiq-threads). [OPTIONAL]
SIDEKIQ_THREADS=5
# DB_POOL: The size of the DB connection pool, must be *at least* the same as `SIDEKIQ_THREADS`. See [notes](https://docs.joinmastodon.org/admin/scaling/#sidekiq-threads). [OPTIONAL]
DB_POOL=5
# NO_CHOWN: Set to `true` to skip chown of /config on init. *READ THE APPLICATION NOTES BEFORE SETTING THIS*. [OPTIONAL]
NO_CHOWN=
# MASTODON_PROMETHEUS_EXPORTER_ENABLED: If set to `true`, Mastodon’s Ruby processes (web & Sidekiq) will enable the Prometheus instrumentation. [OPTIONAL]
MASTODON_PROMETHEUS_EXPORTER_ENABLED=
